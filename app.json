{
  "expo": {
    "name": "ExpenseFlow",
    "slug": "expenseflow",
    "version": "1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "expenseflow",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "1.0",
    "android": {
      "package": "com.expenseflow",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "com.expenseflow",
      "supportsTablet": false
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/10ef4f55-d0ea-404e-8e72-cc64e92cb5ed"
    },
    "extra": {
      "eas": {
        "projectId": "10ef4f55-d0ea-404e-8e72-cc64e92cb5ed"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/GoogleSans-Regular.ttf",
            "./assets/fonts/GoogleSans-Medium.ttf",
            "./assets/fonts/GoogleSans-SemiBold.ttf",
            "./assets/fonts/GoogleSans-Bold.ttf",
            "./assets/fonts/PlayfairDisplay-Regular.ttf",
            "./assets/fonts/PlayfairDisplay-Medium.ttf",
            "./assets/fonts/PlayfairDisplay-SemiBold.ttf",
            "./assets/fonts/PlayfairDisplay-Bold.ttf"
          ]
        }
      ]
    ]
  }
}
