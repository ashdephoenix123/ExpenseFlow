# Controls what is uploaded to EAS Build servers.
# When this file exists, EAS CLI uses it INSTEAD of .gitignore to filter the
# project archive. It mirrors .gitignore with two deliberate differences:
#
#   1. android/gradle.properties IS uploaded (unlike .gitignore). It defines
#      hermesEnabled / newArchEnabled / signing properties; without it the
#      remote Gradle build fails at app/build.gradle with
#      "Could not get unknown property 'hermesEnabled'".
#   2. The release upload keystore IS uploaded (still git-ignored) so remote
#      release builds are signed identically to local ones.
#
# .env stays excluded on purpose: scripts/write-env.js recreates it on the
# build server from EAS environment variables.

# OSX
.DS_Store

# Xcode
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local
.env

# Android/IntelliJ
android/build/
android/app/build/
android/app/.cxx/
android/.kotlin/
android/.gradle/
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
!android/app/my-upload-key.keystore
.kotlin/

# node.js
node_modules/
npm-debug.log
yarn-error.log

# JVM crash dumps
hs_err_pid*.log
replay_pid*.log

# fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Expo
.expo
dist/
web-build/
